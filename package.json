{
  "name": "cypress-api-jenkins",
  "version": "1.0.0",
  "private": true,
  "description": "Ejemplo de pruebas de API con Cypress, JSON Server y Jenkins",
  "scripts": {
    "seed": "node -e \"require('fs').copyFileSync('db.seed.json','db.json')\"",
    "api": "npm run seed && json-server --watch db.json --port 3000",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "start-server-and-test api http://localhost:3000 cy:run"
  },
  "keywords": [
    "cypress",
    "api-testing",
    "json-server",
    "jenkins",
    "testing"
  ],
  "author": "cedaniel200",
  "license": "MIT",
  "devDependencies": {
    "cypress": "^16.2.1",
    "json-server": "^0.17.4",
    "start-server-and-test": "^3.0.13"
  }
}
